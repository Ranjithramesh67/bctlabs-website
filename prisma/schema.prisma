generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model activity_log {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  log_name     String?
  description  String    @db.Text
  subject_type String?
  subject_id   BigInt?   @db.UnsignedBigInt
  causer_type  String?
  causer_id    BigInt?   @db.UnsignedBigInt
  properties   String?   @db.Text
  batch_uuid   String?   @db.Char(36)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)

  @@index([log_name], map: "activity_log_log_name_index")
  @@index([causer_type, causer_id], map: "causer")
  @@index([subject_type, subject_id], map: "subject")
}

model addresses {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  owner_id   Int?
  owner_type String?
  street     String?
  city       String?
  state      String?
  zip        String?
  country    String?
  type       String?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model admin_chat_messages {
  id          BigInt   @id @default(autoincrement())
  sender_id   BigInt
  receiver_id BigInt
  message     String?  @db.Text
  type        String?  @db.VarChar(255)
  file_path   String?  @db.VarChar(255)
  is_read     Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.Timestamp(0)
}

model announcements {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  subject         String
  date            DateTime  @db.DateTime(0)
  message         String?   @db.Text
  show_to_clients Boolean?  @default(false)
  status          Boolean   @default(false)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
}

model app_general_setting {
  id         Int       @id @default(autoincrement())
  u_key      String?   @db.VarChar(255)
  value      String    @db.VarChar(255)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
}

model blog_categories {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  blog_category_name String    @db.VarChar(255)
  is_deleted         Boolean   @default(false)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
}

model blogs {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title      String?   @db.VarChar(255)
  blog_image String?   @db.VarChar(255)
  content    String?   @db.LongText
  is_deleted Int
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model business_settings {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  type       String    @db.VarChar(50)
  value      String    @db.LongText
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model career_applications {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name             String    @db.VarChar(255)
  mobile           String    @db.VarChar(20)
  email            String    @unique(map: "career_applications_email_unique") @db.VarChar(255)
  resume_path      String    @db.VarChar(255)
  qualification    String?   @db.VarChar(255)
  dob              String?   @db.VarChar(55)
  whatsappMobile   String?   @db.VarChar(55)
  gender           String?   @db.VarChar(55)
  yearofexperience String?   @db.VarChar(255)
  address          String    @db.Text
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
}

model categories {
  id              Int      @id @default(autoincrement())
  category_name   String   @db.VarChar(255)
  category_logo   String?  @db.VarChar(255)
  category_photo  String?  @db.VarChar(255)
  category_url    String?  @db.VarChar(255)
  is_deleted      Int      @default(0)
  is_popular      Int      @default(0)
  home_status     Int      @default(0)
  primary_color   String?  @db.VarChar(255)
  secondary_color String?  @db.VarChar(255)
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(now()) @db.Timestamp(0)
}

model cities {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  name       String?   @db.VarChar(255)
  state_id   Int?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model consultations {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(255)
  designation      String   @db.VarChar(50)
  lab_type         String   @db.VarChar(50)
  school           String   @db.VarChar(255)
  city             String   @db.VarChar(255)
  mobile           String   @db.VarChar(10)
  email            String   @db.VarChar(255)
  class_range      String   @db.VarChar(100)
  student_strength Int
  preferred_date   DateTime @db.Date
  preferred_time   DateTime @db.Time(0)
  preferred_mode   String   @db.VarChar(50)
  heard_about      String   @db.VarChar(50)
  questions        String   @db.Text
  created_at       DateTime @default(now()) @db.Timestamp(0)
  updated_at       DateTime @default(now()) @db.Timestamp(0)
}

model contact_email_notifications {
  id                    Int                 @id @default(autoincrement()) @db.UnsignedInt
  contact_id            Int                 @db.UnsignedInt
  email_notification_id Int                 @db.UnsignedInt
  created_at            DateTime?           @db.Timestamp(0)
  updated_at            DateTime?           @db.Timestamp(0)
  contacts              contacts            @relation(fields: [contact_id], references: [id], onDelete: Cascade, map: "contact_email_notifications_contact_id_foreign")
  email_notifications   email_notifications @relation(fields: [email_notification_id], references: [id], onDelete: Cascade, map: "contact_email_notifications_email_notification_id_foreign")

  @@index([contact_id], map: "contact_email_notifications_contact_id_foreign")
  @@index([email_notification_id], map: "contact_email_notifications_email_notification_id_foreign")
}

model contact_messages {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  email      String    @db.VarChar(255)
  subject    String    @db.VarChar(255)
  mobile     String    @db.VarChar(20)
  message    String    @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
}

model contacts {
  id                          Int                           @id @default(autoincrement()) @db.UnsignedInt
  customer_id                 Int                           @db.UnsignedInt
  user_id                     Int?                          @db.UnsignedInt
  position                    String?
  primary_contact             Boolean                       @default(false)
  send_welcome_email          Boolean                       @default(false)
  send_password_email         Boolean                       @default(false)
  created_at                  DateTime?                     @db.Timestamp(0)
  updated_at                  DateTime?                     @db.Timestamp(0)
  contact_email_notifications contact_email_notifications[]
  customers                   customers                     @relation(fields: [customer_id], references: [id], onDelete: Cascade, map: "contacts_customer_id_foreign")
  users                       users?                        @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "contacts_user_id_foreign")

  @@index([customer_id], map: "contacts_customer_id_foreign")
  @@index([user_id], map: "contacts_user_id_foreign")
}

model countries {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  name       String
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model credit_note_addresses {
  id             Int          @id @default(autoincrement()) @db.UnsignedInt
  credit_note_id Int          @db.UnsignedInt
  type           Int
  street         String?      @db.Text
  city           String?
  state          String?
  zip_code       String?
  country        String?
  created_at     DateTime?    @db.Timestamp(0)
  updated_at     DateTime?    @db.Timestamp(0)
  credit_notes   credit_notes @relation(fields: [credit_note_id], references: [id], onDelete: Cascade, map: "credit_note_addresses_credit_note_id_foreign")

  @@index([credit_note_id], map: "credit_note_addresses_credit_note_id_foreign")
}

model credit_notes {
  id                    Int                     @id @default(autoincrement()) @db.UnsignedInt
  title                 String
  customer_id           Int                     @db.UnsignedInt
  credit_note_number    String
  credit_note_date      DateTime                @db.DateTime(0)
  currency              Int
  discount_type         Int?
  reference             String?
  discount              Float?
  admin_text            String?                 @db.Text
  unit                  Int
  client_note           String?                 @db.Text
  term_conditions       String?                 @db.Text
  sub_total             Float?
  adjustment            String                  @default("0")
  total_amount          Float?
  payment_status        Int?
  discount_symbol       Int?
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  credit_note_addresses credit_note_addresses[]
  customers             customers               @relation(fields: [customer_id], references: [id], onDelete: Cascade, map: "credit_notes_customer_id_foreign")

  @@index([customer_id], map: "credit_notes_customer_id_foreign")
}

model customer_groups {
  id                          Int                           @id @default(autoincrement()) @db.UnsignedInt
  name                        String                        @unique(map: "customer_groups_name_unique")
  description                 String?                       @db.Text
  created_at                  DateTime?                     @db.Timestamp(0)
  updated_at                  DateTime?                     @db.Timestamp(0)
  customer_to_customer_groups customer_to_customer_groups[]
}

model customer_to_customer_groups {
  id                Int             @id @default(autoincrement()) @db.UnsignedInt
  customer_id       Int             @db.UnsignedInt
  customer_group_id Int             @db.UnsignedInt
  created_at        DateTime?       @db.Timestamp(0)
  updated_at        DateTime?       @db.Timestamp(0)
  customer_groups   customer_groups @relation(fields: [customer_group_id], references: [id], onDelete: Cascade, map: "customer_to_customer_groups_customer_group_id_foreign")
  customers         customers       @relation(fields: [customer_id], references: [id], onDelete: Cascade, map: "customer_to_customer_groups_customer_id_foreign")

  @@index([customer_group_id], map: "customer_to_customer_groups_customer_group_id_foreign")
  @@index([customer_id], map: "customer_to_customer_groups_customer_id_foreign")
}

model customers {
  id                          Int                           @id @default(autoincrement()) @db.UnsignedInt
  user_id                     Int                           @db.UnsignedInt
  username                    String                        @db.VarChar(255)
  userbusiness_name           String?                       @db.VarChar(255)
  mobile_number               String                        @unique(map: "mobile_number") @db.VarChar(15)
  address                     String?                       @db.Text
  userphoto                   String?                       @db.VarChar(255)
  userbusiness_photo          String?                       @db.VarChar(255)
  phone                       String?                       @db.VarChar(15)
  currency                    String?                       @db.VarChar(10)
  default_language            String?                       @db.VarChar(10)
  created_at                  DateTime                      @default(now()) @db.Timestamp(0)
  updated_at                  DateTime                      @default(now()) @db.Timestamp(0)
  contacts                    contacts[]
  credit_notes                credit_notes[]
  customer_to_customer_groups customer_to_customer_groups[]

  @@index([user_id], map: "user_id")
}

model dashboard_slider {
  id          BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  title       String
  description String?               @db.Text
  image       String?
  type        dashboard_slider_type
  status      Boolean               @default(true)
  created_at  DateTime?             @db.Timestamp(0)
  updated_at  DateTime?             @db.Timestamp(0)
}

model departments {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  name       String    @unique(map: "departments_name_unique")
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model designation {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

model email_notifications {
  id                          Int                           @id @default(autoincrement()) @db.UnsignedInt
  name                        String
  created_at                  DateTime?                     @db.Timestamp(0)
  updated_at                  DateTime?                     @db.Timestamp(0)
  contact_email_notifications contact_email_notifications[]
}

model email_templates {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  template_name   String
  template_type   Int
  subject         String?
  from_name       String
  send_plain_text Boolean   @default(false)
  disabled        Boolean   @default(false)
  email_message   String    @db.Text
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
}

model events {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title        String    @db.VarChar(255)
  main_image   String    @db.VarChar(255)
  start_image  String    @db.VarChar(255)
  middle_image String?   @db.VarChar(255)
  end_image    String?   @db.VarChar(255)
  content      String?   @db.Text
  main_condent String?   @db.LongText
  image_4      String?   @db.LongText
  image_5      String?   @db.LongText
  image_6      String?   @db.LongText
  is_deleted   Int
  type         String    @db.VarChar(255)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  date         String?   @db.VarChar(255)
  venue        String?   @db.VarChar(255)
  author_name  String?   @db.VarChar(255)
  orderby_no   Int?
  category_id  BigInt?   @db.UnsignedBigInt
  price        Decimal   @default(0.00) @db.Decimal(15, 2)
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String?  @unique(map: "failed_jobs_uuid_unique")
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model help_topics {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  type       String    @default("default")
  question   String?   @db.Text
  answer     String?   @db.Text
  ranking    Int       @default(1)
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model invoice_addresses {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  invoice_id Int       @db.UnsignedInt
  type       Int
  street     String?   @db.Text
  city       String?
  state      String?
  zip_code   String?
  country    String?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  @@index([invoice_id], map: "invoice_addresses_invoice_id_foreign")
}

model invoice_payment_modes {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  payment_mode_id Int       @db.UnsignedInt
  invoice_id      Int       @db.UnsignedInt
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)

  @@index([invoice_id], map: "invoice_payment_modes_invoice_id_foreign")
  @@index([payment_mode_id], map: "invoice_payment_modes_payment_mode_id_foreign")
}

model invoices {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  title           String
  customer_id     Int       @db.UnsignedInt
  invoice_number  String
  invoice_date    DateTime  @db.Date
  due_date        DateTime? @db.Date
  sales_agent_id  Int?      @db.UnsignedInt
  currency        Int       @default(0)
  discount_type   Int?
  discount        Float?
  admin_text      String?   @db.Text
  unit            Int
  client_note     String?   @db.Text
  term_conditions String?   @db.Text
  sub_total       Float?
  adjustment      String    @default("0")
  total_amount    Float?
  payment_status  Int?
  discount_symbol Int?
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  hsn_tax         String?

  @@index([customer_id], map: "invoices_customer_id_foreign")
  @@index([sales_agent_id], map: "invoices_sales_agent_id_foreign")
}

model languages {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  name            String
  description     String?   @db.Text
  is_default      Boolean   @default(false)
  is_app_language Int       @default(1)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
}

model media {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  model_type            String
  model_id              BigInt    @db.UnsignedBigInt
  collection_name       String
  name                  String
  file_name             String
  mime_type             String?
  disk                  String
  size                  BigInt    @db.UnsignedBigInt
  manipulations         String    @db.Text
  custom_properties     String    @db.Text
  responsive_images     String    @db.Text
  order_column          Int?      @db.UnsignedInt
  created_at            DateTime? @db.Timestamp(0)
  updated_at            DateTime? @db.Timestamp(0)
  conversions_disk      String?
  uuid                  String?   @unique(map: "media_uuid_unique") @db.Char(36)
  generated_conversions String    @db.Text

  @@index([model_type, model_id], map: "media_model_type_model_id_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String
  batch     Int
}

model model_has_permissions {
  permission_id BigInt @db.UnsignedBigInt
  model_type    String
  model_id      BigInt @db.UnsignedBigInt

  @@id([permission_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_permissions_model_id_model_type_index")
}

model model_has_roles {
  role_id    BigInt @db.UnsignedBigInt
  model_type String
  model_id   BigInt @db.UnsignedBigInt

  @@id([role_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_roles_model_id_model_type_index")
}

model notes {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  owner_id   Int
  owner_type String
  note       String?   @db.Text
  added_by   Int       @db.UnsignedInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  @@index([added_by], map: "notes_added_by_foreign")
}

model notifications {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title       String?
  type        String?
  description String?   @db.Text
  read_at     DateTime? @db.Timestamp(0)
  user_id     Int?      @db.UnsignedInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)

  @@index([user_id], map: "notifications_user_id_foreign")
}

model order_items {
  id              Int      @id @default(autoincrement())
  order_id        Int      @db.UnsignedInt
  product_id      Int      @db.UnsignedInt
  category_id     Int      @db.UnsignedInt
  sub_category_id Int      @db.UnsignedInt
  quantity        Int
  price_per_unit  Decimal  @db.Decimal(10, 2)
  total_price     Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(now()) @db.Timestamp(0)
}

model orders {
  id                  Int      @id @default(autoincrement())
  user_id             Int      @db.UnsignedInt
  customer_id         Int      @db.UnsignedInt
  previous_balance    Decimal  @default(0.00) @db.Decimal(15, 2)
  subtotal            Decimal  @db.Decimal(10, 2)
  paid_amount         Decimal  @db.Decimal(10, 2)
  current_day_balance Decimal  @db.Decimal(10, 2)
  remaining_balance   Decimal  @default(0.00) @db.Decimal(15, 2)
  is_deleted          Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamp(0)
  updated_at          DateTime @default(now()) @db.Timestamp(0)

  @@index([customer_id], map: "customer_id")
  @@index([user_id], map: "user_id")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model password_resets {
  email      String
  token      String
  created_at DateTime? @db.Timestamp(0)

  @@index([email], map: "password_resets_email_index")
  @@ignore
}

model payment_modes {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  name        String    @unique(map: "payment_modes_name_unique")
  description String?   @db.Text
  active      Boolean
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model payments {
  id                             Int       @id @default(autoincrement()) @db.UnsignedInt
  owner_id                       Int
  owner_type                     String
  amount_received                Float
  payment_date                   DateTime  @db.DateTime(0)
  payment_mode                   Int       @db.UnsignedInt
  transaction_id                 String?
  note                           String?   @db.Text
  send_mail_to_customer_contacts Boolean?
  stripe_id                      String?
  meta                           String?   @db.Text
  created_at                     DateTime? @db.Timestamp(0)
  updated_at                     DateTime? @db.Timestamp(0)

  @@index([payment_mode], map: "payments_payment_mode_foreign")
}

model permissions {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name         String
  display_name String?
  description  String?
  type         String?
  guard_name   String
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model popular_location {
  id         Int       @id @default(autoincrement())
  location   String?   @db.Text
  latitude   String?   @db.VarChar(255)
  longitude  String?   @db.VarChar(255)
  state_name String?   @db.VarChar(255)
  city_name  String?   @db.VarChar(255)
  status     Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
}

model predefined_replies {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  reply_name String
  body       String?   @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model product_returns {
  id            Int      @id @default(autoincrement())
  customer_id   Int
  product_id    Int
  product_name  String   @db.VarChar(255)
  product_qty   Int
  return_reason String   @db.Text
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model product_stock {
  id              Int      @id @default(autoincrement())
  product_id      Int      @db.UnsignedInt
  user_id         Int      @db.UnsignedInt
  total_stock_in  Int      @default(0)
  total_stock_out Int      @default(0)
  current_stock   Int?
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(now()) @db.Timestamp(0)

  @@index([product_id], map: "product_id")
  @@index([user_id], map: "user_id")
}

model products {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id         Int
