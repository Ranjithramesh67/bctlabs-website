# WordPress database (bctlabs.com).
DATABASE_URL="mysql://user:pass@127.0.0.1:3306/u936390473_ny0Uv"

# 32+ byte base64 secret. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-me"

# Public store URL (used for canonical links in emails/feeds).
APP_URL="http://localhost:4000"

# Cashfree Payment Gateway (https://merchant.cashfree.com).
# Get these from the Cashfree dashboard: Developers -> API Keys.
# Leave them blank to disable online payment (checkout falls back to COD only).
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# "sandbox" for testing, "production" for live payments.
CASHFREE_ENV="sandbox"
# Optional: override the API host/version (useful for Cashfree staging).
CASHFREE_BASE_URL=""
CASHFREE_API_VERSION=""

# NimbusPost Logistics (https://app.nimbuspost.com -> Settings -> API).
# Leave the API key blank to disable shipments; checkout then skips the delivery
# check and admin order pages hide the shipment panel.
NIMBUSPOST_API_KEY=""
# Origin pincode per warehouse. At least one is required for serviceability.
ORIGIN_PINCODE_ARK="631001"
ORIGIN_PINCODE_BLR="560001"
# Warehouse used when a request does not specify one: ARK (default) or BLR.
NIMBUSPOST_DEFAULT_WAREHOUSE="ARK"
# Legacy single-warehouse origin pincode, used when the per-warehouse value is blank.
NIMBUSPOST_ORIGIN_PINCODE=""
# Optional: defaults to https://api.nimbuspost.com/v1
NIMBUSPOST_BASE_URL=""
# Optional: dashboard login used to fetch a bearer token when no API key is set.
NIMBUSPOST_EMAIL=""
NIMBUSPOST_PASSWORD=""
# Optional shared pickup details for both warehouses (fall back to the brand address).
NIMBUSPOST_PICKUP_NAME=""
NIMBUSPOST_PICKUP_ADDRESS=""
NIMBUSPOST_PICKUP_ADDRESS_2=""
NIMBUSPOST_PICKUP_CITY=""
NIMBUSPOST_PICKUP_STATE=""
NIMBUSPOST_PICKUP_PHONE=""
NIMBUSPOST_PICKUP_EMAIL=""
NIMBUSPOST_PICKUP_WAREHOUSE_ID=""
# Optional per-warehouse overrides: NIMBUSPOST_{BLR,ARK}_{NAME,ADDRESS,ADDRESS_2,
# CITY,STATE,PHONE,EMAIL,WAREHOUSE_ID}.
# Per-line parcel weight in grams used when a product has no weight (default 500).
NIMBUSPOST_DEFAULT_ITEM_WEIGHT_GRAMS="500"
# Optional shared secret expected on tracking webhook requests.
NIMBUSPOST_WEBHOOK_SECRET=""
