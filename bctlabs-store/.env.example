# WordPress database (bctlabs.com).
DATABASE_URL="mysql://user:pass@127.0.0.1:3306/u936390473_ny0Uv"

# 32+ byte base64 secret. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-me"

# Public store URL (canonical links, payment return URLs and webhooks).
# Use the public HTTPS origin in production; behind an HTTPS preview proxy a
# localhost value falls back to the forwarded request host.
APP_URL="http://localhost:4000"

# Cashfree Payment Gateway (https://merchant.cashfree.com).
# Get these from the Cashfree dashboard: Developers -> API Keys.
# Leave them blank to disable online payment (checkout falls back to COD only).
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# Optional separate sandbox pair, used when CASHFREE_ENV="sandbox". Lets a live
# pair stay configured for production while previews use test keys.
CASHFREE_SANDBOX_APP_ID=""
CASHFREE_SANDBOX_SECRET_KEY=""
# "sandbox" for test keys, "production" for live keys. Sandbox and production
# key pairs are not interchangeable: each is rejected by the other host.
CASHFREE_ENV="sandbox"
# Verify a pair before deploying: npm run check:cashfree
# Local/test only: simulate a successful Cashfree payment without API keys.
# Ignored when NODE_ENV=production. Leave blank in production.
CASHFREE_MOCK=""
# Optional: override the API host/version (useful for Cashfree staging).
CASHFREE_BASE_URL=""
CASHFREE_API_VERSION=""

# Transactional email (Brevo) used for signup verification codes.
BREVO_API_KEY=""
MAIL_FROM_EMAIL="no-reply@bctlabs.com"
MAIL_FROM_NAME="BCTLABS"

# NimbusPost Logistics (https://app.nimbuspost.com -> Settings -> API Keys).
# Leave the key pair blank to disable shipments; checkout then skips the
# delivery check and admin order pages hide the shipment panel.
# Partner API v2 authenticates with the key id (`npk_...`) + its secret.
NIMBUSPOST_API_KEY=""
NIMBUSPOST_API_SECRET=""
# Origin pincode per warehouse. At least one is required for serviceability.
ORIGIN_PINCODE_ARK="631001"
ORIGIN_PINCODE_BLR="560001"
# Warehouse used when a request does not specify one: ARK (default) or BLR.
NIMBUSPOST_DEFAULT_WAREHOUSE="ARK"
# Legacy single-warehouse origin pincode, used when the per-warehouse value is blank.
NIMBUSPOST_ORIGIN_PINCODE=""
# Optional: defaults to https://api-v2.nimbuspost.com
NIMBUSPOST_BASE_URL=""
# Legacy only: dashboard login used to fetch a bearer token when no key pair is set.
NIMBUSPOST_EMAIL=""
NIMBUSPOST_PASSWORD=""
# Optional shared pickup details for both warehouses (fall back to the brand address).
NIMBUSPOST_PICKUP_NAME=""
NIMBUSPOST_PICKUP_ADDRESS=""
NIMBUSPOST_PICKUP_ADDRESS_2=""
NIMBUSPOST_PICKUP_CITY=""
NIMBUSPOST_PICKUP_STATE=""
NIMBUSPOST_PICKUP_PHONE=""
NIMBUSPOST_PICKUP_EMAIL=""
# Pickup warehouse id. Required to book: create the warehouse in the dashboard
# (its contact phone is OTP-verified there) and copy the id here.
NIMBUSPOST_PICKUP_WAREHOUSE_ID=""
# Optional per-warehouse overrides: NIMBUSPOST_{BLR,ARK}_{NAME,ADDRESS,ADDRESS_2,
# CITY,STATE,PHONE,EMAIL,WAREHOUSE_ID}.
# Per-line parcel weight in grams used when a product has no weight (default 500).
NIMBUSPOST_DEFAULT_ITEM_WEIGHT_GRAMS="500"
# HMAC secret used to verify `x-nimbus-signature` on tracking webhooks.
NIMBUSPOST_WEBHOOK_SECRET=""
