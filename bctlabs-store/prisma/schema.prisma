}

enum wp_awp_user_info_whatsapp_verified {
  Verified
  Not_Verified @map("Not Verified")
}

/// Shipment lifecycle states mirroring NimbusPost tracking updates.
enum ShipmentStatus {
  CREATED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO_IN_TRANSIT
  RTO_DELIVERED
  CANCELLED
  EXCEPTION
  UNKNOWN
}

enum ShipmentPaymentType {
  COD
  PREPAID
}

/// One shipment per WooCommerce order (`order_id` -> wp_wc_orders.id).
model bctlabs_shipments {
  id                      BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  order_id                BigInt              @unique(map: "uniq_shipment_order") @db.UnsignedBigInt
  awb_number              String?             @unique(map: "uniq_shipment_awb") @db.VarChar(64)
  courier_id              String?             @db.VarChar(64)
  courier_name            String?             @db.VarChar(191)
  nimbuspost_shipment_id  String?             @db.VarChar(64)
  status                  ShipmentStatus      @default(CREATED)
  status_code             String?             @db.VarChar(64)
  status_updated_at       DateTime?           @db.DateTime(0)
  freight_amount          Decimal?            @db.Decimal(10, 2)
  cod_amount              Decimal?            @db.Decimal(10, 2)
  payment_type            ShipmentPaymentType @default(PREPAID)
  weight_grams            Int?                @db.UnsignedInt
  manifest_url            String?             @db.VarChar(512)
  label_url               String?             @db.VarChar(512)
  origin_warehouse        String?             @db.VarChar(16)
  origin_pincode          String?             @db.VarChar(10)
  manifest_generated_at   DateTime?           @db.DateTime(0)
  created_at              DateTime            @default(now()) @db.DateTime(0)
  updated_at              DateTime            @default(now()) @updatedAt @db.DateTime(0)

  @@index([status], map: "idx_shipment_status")
  @@index([courier_name], map: "idx_shipment_courier")
}

/// One row per manifest PDF generated for a courier pickup.
model bctlabs_manifests {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  courier_name String   @db.VarChar(191)
  awb_numbers  Json
  pdf_url      String?  @db.VarChar(512)
  created_at   DateTime @default(now()) @db.DateTime(0)

  @@index([courier_name], map: "idx_manifest_courier")
  @@index([created_at], map: "idx_manifest_created")
}

/// Append-only tracking timeline for a shipment (drives the customer stepper).
model bctlabs_shipment_events {
  id          BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  shipment_id BigInt         @db.UnsignedBigInt
  status      ShipmentStatus
  status_code String?        @db.VarChar(64)
  raw_status  String?        @db.VarChar(191)
  occurred_at DateTime       @db.DateTime(0)
  created_at  DateTime       @default(now()) @db.DateTime(0)

  @@unique([shipment_id, status, occurred_at], map: "uniq_shipment_event")
  @@index([shipment_id, occurred_at], map: "idx_shipment_event_shipment")
}

/// Gateway webhook idempotency ledger. event_key is unique per provider event.
model bctlabs_payment_events {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  event_key     String    @unique(map: "uniq_payment_event_key") @db.VarChar(191)
  order_id      BigInt?   @db.UnsignedBigInt
  provider      String    @db.VarChar(32)
  event_type    String    @db.VarChar(64)
  cf_order_id   String?   @db.VarChar(64)
  cf_payment_id String?   @db.VarChar(64)
  amount        Decimal?  @db.Decimal(10, 2)
  payload       Json?
  created_at    DateTime  @default(now()) @db.DateTime(0)

  @@index([order_id], map: "idx_payment_event_order")
  @@index([cf_payment_id], map: "idx_payment_event_payment")
}

/// Short-lived email verification codes (signup, password reset).
model bctlabs_email_verifications {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email       String    @db.VarChar(191)
  purpose     String    @default("signup") @db.VarChar(32)
  code_hash   String    @db.VarChar(191)
  payload     Json?
  attempts    Int       @default(0) @db.UnsignedInt
  expires_at  DateTime  @db.DateTime(0)
  consumed_at DateTime? @db.DateTime(0)
  created_at  DateTime  @default(now()) @db.DateTime(0)

  @@index([email, purpose, created_at], map: "idx_email_verification_lookup")
  @@index([expires_at], map: "idx_email_verification_expiry")
}

model bctlabs_auth_attempts {
  email        String    @id @db.VarChar(191)
  attempts     Int       @default(0) @db.UnsignedInt
  locked_until DateTime? @db.DateTime(0)
  updated_at   DateTime  @default(now()) @updatedAt @db.DateTime(0)
}

model bctlabs_newsletter_subscribers {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  email      String   @unique @db.VarChar(191)
  source     String   @default("homepage") @db.VarChar(50)
  created_at DateTime @default(now()) @db.DateTime(0)
}

/// Saved billing/shipping addresses for returning customers.
model bctlabs_customer_addresses {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id BigInt   @db.UnsignedBigInt
  label       String   @default("Home") @db.VarChar(60)
  first_name  String   @db.VarChar(100)
  last_name   String   @db.VarChar(100)
