# Connection string for the MySQL/MariaDB database (Prisma datasource + app runtime).
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME"

# Secret used to sign/encrypt session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-32-byte-base64-secret"

# Length of time a web session stays valid (Laravel default was 120 minutes).
SESSION_LIFETIME_MINUTES="120"

# Public base URL of the deployment (used for absolute URLs in API responses).
APP_URL="http://localhost:3000"

# Contact form notifications (optional). When BREVO_API_KEY is unset the message
# is still stored in `contact_messages`, but no email is sent.
MAIL_TO_EMAIL=""
MAIL_FROM_EMAIL=""
BREVO_API_KEY=""
